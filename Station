using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using TMPro;
using UnityEngine.UI;

/// <summary>
/// Station is a script that takes items and makes them over a certain time like crafting cooking or alchemy
/// </summary>
public class Station : MonoBehaviour, interactableObject
{
    //Currently it does not queue recipies since the specific project I am working on has no need for it.
    //Eventually change script to craft and store obj in there until taken out, with the ability to increase count
    //ATM, this is a crafting system that works directly for an inventory, perhaps add an inherintance system to fix.



    [Header("Components and GameObjects")]
    public InventorySystem invinTOAddTo; [Tooltip("The inventory that materials will be deposited in")] //A note that if networking p2p this will need to be changed throughout the script based on ownership and which player acceses 
    [SerializeField] int stationUIInt; [Tooltip("An int used to work with handler or UIHandler for setting UI's active")]
    [SerializeField] private playerController playerController;
    [SerializeField] Product[] products; [Tooltip("An array of craftable proudcts for the player to make")]
    [SerializeField] GameObject productMenuPrefab; [Tooltip("The prefab that is used to display the information of a product, like its description")]
    [SerializeField] GameObject ingridientAmountPrefab; [Tooltip("A prefab that displats an ingridients information, like how much is needed to craft something")]
    [SerializeField] UIHandler handler; [Tooltip("A link to a UI managing system, replace when need or use event system")]
     List<IngridientFormat> IngridientsListed = new List<IngridientFormat>(); // this is a list of currently displayed ingridients, will be used for object pooling to increase performance



    [Header("Crafting Logic")]
    public Product productSelected; // The currently selected product either by the player or the system.
    [SerializeField] bool breakCoroutine = false; //Used to cancel crafting, with a SZ for manual 
    bool isCrafting; // is the station currently running the Coroutine, makes sure the player cannot craft too much at once
    bool isMenuInit = false; // Has the stations menu been opened before, makes sure the station does not duplicate it's list of products
    bool ingridientsTaken = false; // have the ingridients needed to craft something been taken, prevents free craft


    [Header("Station UI")]
    public string prompMsg => promptMessage; //The message the player will see when looking at the station
    [SerializeField] string promptMessage; [Tooltip("The message the player will see when looking at the station")]//This is so the message can actually be set, and is what you set in inspector
    [SerializeField] private GameObject stationCanvas; // the empty gameobject used to hold everything to do with canvas
    [SerializeField] TextMeshProUGUI recipieNameTxt; 
    [SerializeField] TextMeshProUGUI recipieDescTxt;
    [SerializeField] TextMeshProUGUI recipieRarTxt;

    [Header("Product Menu Prefab Sizing")]
    [SerializeField] Transform prefabParent; //the content section of the product prefabs scroll view (or just the container in general) DO NOT FORGET A LAYOT GROUP OR GRID
    [SerializeField] Transform ingridientListParent; // the content of ingridients prefab scroll view (or just the container in general)


    /// <summary>
    /// Opens station menu and checks if it has been set up before (begin setup if not)
    /// </summary>
    public void Interact(InventorySystem inventory = null)
    {
        if (isMenuInit == false) // checls to see if the staions menu has been accesed before, if not, it sets it up.
        {
            GenerateStationMenu();
            isMenuInit = true;
        }
        handler.ToggleUI(stationUIInt);
    }

    /// <summary>
    /// This function runs the wholep procces of a station from outside acces
    /// </summary>
    public void UseStation(){
        TakeIngridients();
        IngAmountOwned();
        if (ingridientsTaken)
        {
            isCrafting = true;
            StartCoroutine(StationActive());
        }

    }

    /// <summary>
    /// Sets the products crafting information in UI
    /// </summary>
    public void DisplayRecipie()
    { 
        // If any of these are triggered, somewher in your coding you have set a string to null, remember inspector sets an empty string to ""
        recipieNameTxt.text = productSelected.title ?? "Title needed";
        recipieDescTxt.text = productSelected.description ?? "Description Needed";
        recipieRarTxt.text = productSelected.rarity ?? (productSelected +  "Rarity not set");
        ReformatIng();
    }


    /// <summary>
    /// This updates front end UI on wether or not the player has enough ingridients to craft an object, before crafting it
    /// </summary>
    public void ReformatIng()           //Rework Take ingridients to rely on this for check and remove the other check, Do a thorough evaluation that it is safe beforehand
    {
        int current = IngridientsListed.Count;
        int target = productSelected.ingridients.Length;

        // Update existing items
        int toFormat = Math.Min(current, target);
        for (int i = 0; i < toFormat; i++)
        {
            IngridientsListed[i].FormatIng(productSelected.ingridients[i], productSelected.amountNeeded[i]);
        }

        // Add missing items
        for (int i = toFormat; i < target; i++)
        {
            var item = Instantiate(ingridientAmountPrefab, ingridientListParent.transform);
            var comp = item.GetComponent<IngridientFormat>();
            IngridientsListed.Add(comp);
            comp.FormatIng(productSelected.ingridients[i], productSelected.amountNeeded[i]);
        }

        // Remove extra items
        while (IngridientsListed.Count > target)
        {
            var last = IngridientsListed[^1];
            Destroy(last.gameObject);
            IngridientsListed.RemoveAt(IngridientsListed.Count - 1);
        }
    }



    //Removes the ingridients from inventory and prepares for crafting
    private void TakeIngridients()
    {
        if (!isCrafting)
        {
            for (int i = 0; i < productSelected.ingridients.Length; i++)
            {
                if (productSelected.ingridients != null && !(productSelected.ingridients[i].connectedObj.count >= productSelected.amountNeeded[i]))// != null is defensive for an item that does not need any ingridients
                {                    
                    for (int j = i; j > 0; j--)
                    { 
                            invinTOAddTo.AddItem(productSelected.ingridients[j], productSelected.amountNeeded[j]);
                    }
                    Debug.Log("You do not have sufficient ingridients!");
                    return;
                }
                else
                {
                    invinTOAddTo.RemoveItem(productSelected.ingridients[i], productSelected.amountNeeded[i]);
                }

            }

            ingridientsTaken = true;

        }
    }


    //Actual timer mechanism to produce object.
    IEnumerator StationActive()
    {
        Product productCache = productSelected; // Stops players from clicking another recipie to add that one instead
        float productionTimer = productSelected.productionTime;
        
        while (productionTimer >= 0)
        {
            productionTimer -= Time.deltaTime;
            if (breakCoroutine == true)
            {
                ReturnItems();
                break;
            }
            
            Debug.Log("productionTimer");
            //Prouduce ingame effects that show produciton progress.
            yield return null;
        }

        //Adds item to invin and resets system
        invinTOAddTo.AddItem(productCache, productCache.amountToAdd);
        isCrafting = false;
        ingridientsTaken = false;
    }


    //returns items in the even that a products crafting is cancled
    void ReturnItems()
    {
        // run this when someone cancels a recipie

    }


    //This creates the stations menu that shows a list of avaible products and their recipies. 
    private void GenerateStationMenu()
    {
        if (products != null) // males sure values are assighned
        {
            for (int i = 0; i < products.Length; i++)
            {
                GameObject instance = Instantiate(productMenuPrefab, prefabParent);
                var entry = instance.GetComponent<FormulateProductPrefab>();

                entry.Format(products[i], this);

            }
        }
    }

    //This updates the text of the ing to match the amount you now have after crafting.   CHANGE NAME LATER

    private void IngAmountOwned()
    {
        for (int i = 0; i < IngridientsListed.Count; i++)
        {
            IngridientsListed[i].UpdateAmount();
        }
    }


}
