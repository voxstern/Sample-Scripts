    /// <summary>
    /// Opens station menu and checks if it has been set up before (begin setup if not)
    /// </summary>
    /// <param name="inventory"></param>
    public void Interact(InventorySystem inventory = null)
    {
        if (isMenuInit == false) // checls to see if the staions menu has been accesed before, if not, it sets it up.
        {
            GenerateStationMenu();
            isMenuInit = true;
        }
        handler.ToggleUI(stationUIInt);
    }

    /// <summary>
    /// This function runs the wholep procces of a station from outside acces
    /// </summary>
    public void UseStation(){
        TakeIngridients();
        IngAmountOwned();
        if (ingridientsTaken)
        {
            isCrafting = true;
            StartCoroutine(StationActive());
        }

    }

    /// <summary>
