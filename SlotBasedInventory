using System.Collections.Generic;
using UnityEngine;

public class InventorySystem : MonoBehaviour
{
    //Not completely finihed, still needs a few methods for polishing.

    [Header("Inventory Capacity")]
    [SerializeField] private bool isAMaxInventorySlots = true;
    [SerializeField] private int unlockedInventorySlots = 20;
    [SerializeField] private int currUsedInventorySlots = 0;
    [SerializeField] private int maxCount = 99;

    [Header("Inventory Objects")]
    [SerializeField] private GameObject inventorySlotPrefab;
    [SerializeField] private inventoryObj[] inventorySlots; // Pre-made slots
    [SerializeField] private bool areItemsStackable = true;

    private inventoryObj[] cachedSlots;
    private List<inventoryObj> inventoryObjects = new List<inventoryObj>();

    private void Awake()
    {
        // Cache components for performance
        cachedSlots = new inventoryObj[inventorySlots.Length];
        for (int i = 0; i < inventorySlots.Length; i++)
        {
            cachedSlots[i] = inventorySlots[i].GetComponent<inventoryObj>();
        }
    }

    /// <summary>
    /// Adds an item to the inventory. Stacks if possible; otherwise, puts it in an empty slot.
    /// </summary>
    public void AddItem(scriptableInventoryObj itemToAdd, int amountToAdd = 1)
    {
        if (areItemsStackable && itemToAdd.isCountable)
        {
            for (int i = 0; i < cachedSlots.Length; i++)
            {
                var slot = cachedSlots[i];
                if (slot.objectInformation == itemToAdd && slot.count + amountToAdd <= maxCount)
                {
                    slot.count += amountToAdd;
                    Debug.Log($"Added {amountToAdd} to existing slot {i}");
                    return;
                }
            }
        }

        // Check if inventory is full
        if (isAMaxInventorySlots && currUsedInventorySlots >= unlockedInventorySlots)
        {
            Debug.LogWarning("Inventory is full!");
            return;
        }

        // Put in an empty slot
        for (int i = 0; i < cachedSlots.Length; i++)
        {
            var slot = cachedSlots[i];
            if (slot.objectInformation == null)
            {
                slot.objectInformation = itemToAdd;
                slot.count = amountToAdd;
                slot.InitializeItem();
                currUsedInventorySlots++;
                inventoryObjects.Add(slot);
                Debug.Log($"Added {itemToAdd.name} to empty slot {i}");
                return;
            }
        }
    }

    /// <summary>
    /// Removes an item from the inventory.
    /// </summary>
    public void RemoveItem(inventoryObj itemToRemove, int amount)
    {
        if (itemToRemove == null) return;

        itemToRemove.count -= amount;
        if (itemToRemove.count <= 0)
        {
            itemToRemove.objectInformation = null;
            currUsedInventorySlots--;
            inventoryObjects.Remove(itemToRemove);
        }
    }
}
