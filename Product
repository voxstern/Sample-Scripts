using TMPro;
using UnityEngine;
using UnityEngine.UI;
[CreateAssetMenu(fileName = "Assets", menuName = "product")]

public class Product : scriptableInventoryObj
{
    //The information for a craftable Obj that goes into station

    public float productionTime;
    public scriptableInventoryObj[] ingridients;
    public int[] amountNeeded;
    public string rarity;
    public string type;
    public int amountToAdd = 1;


    /// <summary>
    /// Sets UI information for the product, used for the Proudct menu prefab in station
    /// </summary>
    public void InitializeRecipie(TextMeshProUGUI title, TextMeshProUGUI amount, int id, Image dispImage)
    {
        title.text = this.title;
        amount.text = amountNeeded[id].ToString();
        dispImage.sprite = this.itemImage;
    }
}
